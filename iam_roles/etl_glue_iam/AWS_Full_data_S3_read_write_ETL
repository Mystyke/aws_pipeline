
{"_comment": "Inline Policy: AWS_Full_data_S3_read_write_ETL_Policy",
	"Version": "2012-10-17",
	"Statement": [
		{
			"Effect": "Allow",
			"Action": "s3:GetObject",
			"Resource": "arn:aws:s3:::roshan-de-practice-2026/raw_data_full/*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": "arn:aws:s3:::roshan-de-practice-2026/full_data_parquet/*"
		},
		{
			"Effect": "Allow",
			"Action": "s3:ListBucket",
			"Resource": "arn:aws:s3:::roshan-de-practice-2026",
			"Condition": {
				"StringLike": {
					"s3:prefix": [
						"raw_data_full/*",
						"full_data_parquet/*"
					]
				}
			}
		},
		{
			"Effect": "Allow",
			"Action": "s3:GetObject",
			"Resource": "arn:aws:s3:::aws-glue-assets-810876576924-eu-north-1/scripts/*"
		}
	]
}
