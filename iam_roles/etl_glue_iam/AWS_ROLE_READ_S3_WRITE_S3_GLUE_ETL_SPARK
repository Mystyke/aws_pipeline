{
  "_comment":"Inline Policy: AWS_ROLE_READ_S3_WRITE_S3_GLUE_ETL_SPARK_Policy",
	"Version": "2012-10-17",
	"Statement": [
		{
			"Effect": "Allow",
			"Action": "s3:GetObject",
			"Resource": "arn:aws:s3:::roshan-de-practice-2026/Raw__data/*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": "arn:aws:s3:::roshan-de-practice-2026/clean-parquet/*"
		},
		{
			"Effect": "Allow",
			"Action": "s3:ListBucket",
			"Resource": "arn:aws:s3:::roshan-de-practice-2026",
			"Condition": {
				"StringLike": {
					"s3:prefix": [
						"Raw__data/*",
						"clean-parquet/*"
					]
				}
			}
		},
		{
			"Effect": "Allow",
			"Action": "s3:GetObject",
			"Resource": "arn:aws:s3:::aws-glue-assets-<ACCOUNT_ID>-eu-north-1/scripts/*"
		}
	]
}
